# Configuración del Servidor
PORT=8080

# Configuración de Base de Datos (Credenciales coinciden con docker-compose)
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=
DB_SSLMODE=

# Horas (0-23) America/Caracas para scrape BCV interno (backup local)
BCV_DAILY_HOURS=7,17

# Secreto para POST /api/v1/economia/bcv/capturar (Cloud Scheduler)
# Debe coincidir con el header X-Cron-Secret del job en GCP
BCV_CRON_SECRET=
